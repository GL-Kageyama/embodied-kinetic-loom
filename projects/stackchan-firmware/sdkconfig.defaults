# Measured on the unit in hand, 2026-10-18: 16 MiB flash, QIO.
# ⚠️ These two are not preferences. The vendor bootloader on flash was built
#    with them, and an app that disagrees with it misreads its own flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The partition table is the vendor's, byte for byte. ⛔ It is not ours to
# change while the vendor bootloader is the one on flash: the app reads the
# zeros out of this table's `nvs` partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The console is the port that was measured to speak: USB Serial/JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# No PSRAM, no camera, no Bluetooth: this image moves two servos, twelve LEDs,
# a face on a screen and a speaker. ⚠️ Leaving a subsystem out is a decision,
# not an omission. ⛔ The line used to say "no Wi-Fi" — and on 2026-10-21 the
#    radio was started (`main/wifi.cpp`), so that sentence had become false
#    while it sat here unread. **Wi-Fi is now in the image**; what it carries is
#    stated where the code is, and it carries no frame and no pose.
CONFIG_SPIRAM=n
CONFIG_BT_ENABLED=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# ⛔ The event loop task's stack, and IDF's default of 2304 is too small for
#    this image. Measured 2026-10-21: the board boot-looped — every boot died
#    about a second after the address arrived, with `LoadProhibited` on a `l32i`
#    from a queue pointer whose fields held PS-register values. A coredump
#    named the crashing task `sys_evt`, interrupted inside
#    `esp_netif_lwip_ipc_call_get_netif` (the IPC round trip behind
#    `esp_netif_get_ip_info`), with a stack that had run past its end into the
#    heap. At 4096 the same handler reports **1600 bytes never used**, so the
#    need was about 2496 — over the 2304 default by roughly 200.
#    ⚠️ This belongs in `sdkconfig.defaults` and not in `sdkconfig`, because
#    `sdkconfig` is generated and gitignored: a fix living only there is a fix
#    that vanishes on a clean checkout.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ⚠️ A coredump kept in flash, and the partition for it was already in the
#    vendor's table at 0xe00000 (0x10000). On 2026-10-21 this is what named the
#    overflow above: without it the crash printed a backtrace through a
#    corrupted stack and said nothing useful. On: the next crash explains
#    itself. Off: the next crash is a boot loop with addresses in it.
#    ⛔ Read it back with `read_flash 0xe00000 0x10000`, carve the ELF at
#    offset 0x18, and run `esp_coredump info_corefile` with IDF exported.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# ⛔ **The receive window, raised on 2026-10-21 because a stream was slow.**
#    IDF's default is 5,760 bytes — four MSS. Measured on the unit while
#    speech was being pushed to the board: **`dial: link read` grew at about
#    13 KB/s**, and one 512-byte `recv` arrived every 36 ms, while the sound
#    needs 48,000 B/s (24 kHz, 16-bit, mono). ⚠️ **A window is a ceiling on
#    window/RTT, and four MSS of ceiling is spent before the radio is asked
#    for anything.** The Mac's own send buffer took the whole 133 KB at once,
#    so the ceiling was here, not there.
#    ⚠️ These are numbers chosen to be measured; the rate after them is the
#    measurement, and it goes in `projects/stackchan-firmware/README.md`.
# ⛔ **A host that goes away without closing the socket must be noticed.** On
#    2026-10-21 a daemon restart left the board's connection in `FIN_WAIT_1`
#    with no ACK for over a minute, and `DialTask` has no read timeout. Now that
#    an absent host puts the body to sleep, that half-open connection would keep
#    the screen lit all night. lwIP accepts `SO_KEEPALIVE` without this option
#    and applies its own hours-long defaults; with it, `dial.cpp` asks for
#    10 s idle / 5 s between probes / 3 probes — about 25 s to a dead socket.
CONFIG_LWIP_TCP_KEEPALIVE=y

CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=8
